<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    android:hapticFeedbackEnabled="true"
    app:cardUseCompatPadding="true"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/meal_image"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:contentDescription="@string/meal_image_desc"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedImageShape"
            tools:srcCompat="@tools:sample/avatars" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:padding="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/meal_name"
                style="@style/textCardInRecyclerViewMealOfTheDay"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:lines="1"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/delet_ic"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="dfgdfgdfgfgdfgd" />

            <ImageView
                android:id="@+id/delet_ic"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:src="@drawable/delete_ic"
                android:padding="3dp"
                app:layout_constraintBottom_toBottomOf="@+id/meal_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/meal_name"
                app:layout_constraintTop_toTopOf="@+id/meal_name" />

        </androidx.constraintlayout.widget.ConstraintLayout>
        <Button
            android:id="@+id/btn_add_to_fav"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            style="@style/GeneralButton"
            android:layout_margin="6dp"
            android:text="@string/add_to_my_plan"
            android:textSize="12sp"
            />


    </LinearLayout>
</androidx.cardview.widget.CardView>